# Server/API/worker environment only. Never bundle these credential files.
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
APNS_KEY_FILE=/run/secrets/AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.staynest.app
# sandbox for development device builds; production for TestFlight/App Store.
APNS_ENV=production
